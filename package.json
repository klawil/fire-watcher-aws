    "@aws-sdk/lib-dynamodb": "^3.1171.0",
    "@aws-sdk/protocol-http": "^3.370.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@aws-sdk/signature-v4": "^3.370.0",
    "@next/env": "^15.5.29",
    "@next/third-parties": "^15.5.29",
    "aws-cdk-lib": "^2.277.0",
    "bootstrap": "^5.3.9",
    "chart.js": "^4.6.1",
